<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="felt">#0E5A3A</color>
    <color name="icon_background">#B3261E</color>

    <!-- The window background matches the table felt so launching never flashes white. -->
    <style name="Theme.Doudizhu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/felt</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
